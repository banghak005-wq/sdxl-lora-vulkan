+// Backward helpers for ops whose gradient is assembled from existing forward ops inside the backward graph.
+// Only the op's input is kept from the forward pass; intermediates below live only in the backward graph.
+
+// d/dx of y = (x - mean(x)) / sqrt(var(x) + eps), rows along ne0
+static struct ggml_tensor * ggml_norm_rows_back(struct ggml_context * ctx, struct ggml_tensor * x, struct ggml_tensor * g, float eps) {
+    struct ggml_tensor * xc  = ggml_sub(ctx, x, ggml_mean(ctx, x));
+    struct ggml_tensor * sd  = ggml_sqrt(ctx, ggml_scale_bias(ctx, ggml_mean(ctx, ggml_sqr(ctx, xc)), 1.0f, eps));
+    struct ggml_tensor * y   = ggml_div(ctx, xc, sd);
+    struct ggml_tensor * mg  = ggml_mean(ctx, g);
+    struct ggml_tensor * mgy = ggml_mean(ctx, ggml_mul(ctx, g, y));
+    return ggml_div(ctx, ggml_sub(ctx, ggml_sub(ctx, g, mg), ggml_mul(ctx, y, mgy)), sd);
+}
+
+// tanh-approximated GELU and its derivative, written with sigmoid so large |a| cannot overflow:
+// gelu(a) = a * s, s = sigmoid(2u), u = k (a + 0.044715 a^3), k = sqrt(2/pi)
+// gelu'(a) = s + a * 2 s (1 - s) * k (1 + 3 * 0.044715 a^2)
+static struct ggml_tensor * ggml_gelu_tanh_sigmoid(struct ggml_context * ctx, struct ggml_tensor * a) {
+    const float k = 0.7978845608028654f;
+    struct ggml_tensor * u = ggml_scale(ctx, ggml_mul(ctx, a, ggml_scale_bias(ctx, ggml_sqr(ctx, a), 0.044715f, 1.0f)), 2.0f * k);
+    return ggml_sigmoid(ctx, u);
+}
+
+static struct ggml_tensor * ggml_gelu_tanh_grad(struct ggml_context * ctx, struct ggml_tensor * a) {
+    const float k = 0.7978845608028654f;
+    struct ggml_tensor * sg  = ggml_gelu_tanh_sigmoid(ctx, a);
+    struct ggml_tensor * ds  = ggml_mul(ctx, sg, ggml_scale_bias(ctx, sg, -1.0f, 1.0f));                // s (1 - s)
+    struct ggml_tensor * du  = ggml_scale_bias(ctx, ggml_sqr(ctx, a), 2.0f * k * 3.0f * 0.044715f, 2.0f * k);  // 2 du/da
+    return ggml_add(ctx, sg, ggml_mul(ctx, a, ggml_mul(ctx, ds, du)));
+}
