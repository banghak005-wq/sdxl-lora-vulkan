diff --git a/src/ggml-vulkan/vulkan-shaders/im2col_back.comp b/src/ggml-vulkan/vulkan-shaders/im2col_back.comp
new file mode 100644
index 00000000..26468f2c
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/im2col_back.comp
@@ -0,0 +1,67 @@
+#version 450
+
+#include "types.glsl"
+
+// Gradient of im2col: sums the im2col-shaped gradient [N, OH, OW, IC*KH*KW]
+// back into the input layout [N, IC, IH, IW]. One invocation per input element.
+layout(push_constant) uniform parameter {
+    uint IW; uint IH; uint IC;
+    uint OW; uint OH;
+    uint KW; uint KH;
+    uint pelements;
+    uint dst_ofs_n; uint dst_ofs_c;
+    int s0; int s1;
+    int p0; int p1;
+    int d0; int d1;
+} p;
+
+layout(constant_id = 0) const uint BLOCK_SIZE = 512;
+
+layout (local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer X {float data_a[];};
+layout(binding = 1) writeonly buffer D {float data_d[];};
+
+void main() {
+    const uint workgroup = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
+    const uint idx = workgroup * BLOCK_SIZE + gl_LocalInvocationID.x;
+    if (idx >= p.pelements) {
+        return;
+    }
+
+    const uint iiw = idx % p.IW;
+    uint tmp = idx / p.IW;
+    const uint iih = tmp % p.IH; tmp /= p.IH;
+    const uint iic = tmp % p.IC;
+    const uint in_ = tmp / p.IC;
+
+    const uint CHW = p.IC * p.KH * p.KW;
+
+    float grad = 0.0f;
+    for (uint ikh = 0; ikh < p.KH; ikh++) {
+        // GLSL leaves % of negative ints undefined, so reject negatives before the stride test
+        const int tmph = int(iih) + p.p1 - int(ikh) * p.d1;
+        if (tmph < 0 || (tmph % p.s1) != 0) {
+            continue;
+        }
+        const int ioh = tmph / p.s1;
+        if (ioh >= int(p.OH)) {
+            continue;
+        }
+        for (uint ikw = 0; ikw < p.KW; ikw++) {
+            const int tmpw = int(iiw) + p.p0 - int(ikw) * p.d0;
+            if (tmpw < 0 || (tmpw % p.s0) != 0) {
+                continue;
+            }
+            const int iow = tmpw / p.s0;
+            if (iow >= int(p.OW)) {
+                continue;
+            }
+            const uint src = ((in_ * p.OH + uint(ioh)) * p.OW + uint(iow)) * CHW
+                           + iic * (p.KH * p.KW) + ikh * p.KW + ikw;
+            grad += data_a[src];
+        }
+    }
+
+    data_d[in_ * p.dst_ofs_n + iic * p.dst_ofs_c + iih * p.IW + iiw] = grad;
+}
