+    }
+
+    test_im2col_back(ggml_type type_kernel = GGML_TYPE_F16,
+            std::array<int64_t, 4> ne_input = {10, 10, 3, 1},
+            std::array<int64_t, 4> ne_kernel = {3, 3, 3, 1},
+            int s0 = 1, int s1 = 1, int p0 = 1, int p1 = 1, int d0 = 1, int d1 = 1, bool is_2D = true)
+        : type_kernel(type_kernel), ne_input(ne_input), ne_kernel(ne_kernel),
+          s0(s0), s1(s1), p0(p0), p1(p1), d0(d0), d1(d1), is_2D(is_2D) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t KW = ne_kernel[0];
+        const int64_t KH = is_2D ? ne_kernel[1] : 1;
+        const int64_t IC = is_2D ? ne_input[2] : ne_input[1];
+        const int64_t N  = is_2D ? ne_input[3] : ne_input[2];
+        const int64_t OW = (ne_input[0] + 2*p0 - d0*(KW - 1) - 1)/s0 + 1;
+        const int64_t OH = is_2D ? (ne_input[1] + 2*p1 - d1*(KH - 1) - 1)/s1 + 1 : 1;
+
+        ggml_tensor * kernel = ggml_new_tensor(ctx, type_kernel, 4, ne_kernel.data());
+        ggml_set_name(kernel, "kernel");
+
+        ggml_tensor * grad = is_2D
+            ? ggml_new_tensor_4d(ctx, GGML_TYPE_F32, IC*KH*KW, OW, OH, N)
+            : ggml_new_tensor_3d(ctx, GGML_TYPE_F32, IC*KW, OW, N);
+        ggml_set_name(grad, "grad");
+
+        int64_t ne[4] = { ne_input[0], ne_input[1], ne_input[2], ne_input[3] };
+        ggml_tensor * out = ggml_im2col_back(ctx, grad, kernel, ne, s0, s1, p0, p1, d0, d1, is_2D);
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+};
